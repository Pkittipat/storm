generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Which GitHub repo a project's process files live in, and the App installation used to
/// read/write them. Created once, via the "Connect GitHub" flow (GithubConnectController).
/// `projectId` matches the id in the local projects.json store (see ProcessStore) — projects
/// themselves aren't in Postgres, only this durable link to GitHub survives a redeploy.
model GithubInstallation {
  id             String   @id @default(cuid())
  projectId      String   @unique
  installationId String
  owner          String
  repo           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
