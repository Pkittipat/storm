DATABASE_URL="postgresql://stormm:stormm@localhost:5433/stormm?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# GitHub App used to read/write process files in customers' repos.
# Create one at github.com/settings/apps/new (Contents: Read & write, Pull requests:
# Read & write), then under General settings set "Setup URL" to
# <this API's public URL>/github/callback with "Redirect on update" checked — that's
# what lets GithubConnectController receive installation_id after someone installs it
# (see github-connect/). GITHUB_APP_SLUG is the app's URL slug (from its settings page
# URL), used to build the "Connect GitHub" link.
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY_PATH=".secrets/github-app-private-key.pem"
# Fallback single installation, used by GithubRepo (store/) until it looks up each
# project's own installation from GithubInstallation instead.
GITHUB_APP_INSTALLATION_ID=""
GITHUB_REPO="owner/repo"
