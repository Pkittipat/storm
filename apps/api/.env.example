DATABASE_URL="postgresql://stormm:stormm@localhost:5433/stormm?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# GitHub App used to read/write process files in customers' repos.
# Create one at github.com/settings/apps/new (Contents: Read & write), install it
# on a repo, then fill these in from the app's settings page.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY_PATH=".secrets/github-app-private-key.pem"
GITHUB_APP_INSTALLATION_ID=""
GITHUB_REPO="owner/repo"
